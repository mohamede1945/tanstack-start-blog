{
  "name": "tanstack-start-blog",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "generate-rss": "node --experimental-strip-types scripts/generate-rss.ts",
    "dev": "npm run generate-rss && vite",
    "build": "npm run generate-rss && vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "clean": "tsgo -b --clean",
    "typecheck": "tsgo -b",
    "prepare": "husky",
    "lint:deep": "npm run lint && oxlint --type-aware --type-check && eslint . --max-warnings 0",
    "lint": "biome check --error-on-warnings && oxlint . --max-warnings 0",
    "lint:fix": "biome check --write --unsafe --error-on-warnings && oxlint . --max-warnings 0 --fix",
    "lint:changed": "biome check --changed --error-on-warnings",
    "lint:staged": "biome check --staged --error-on-warnings",
    "og:social": "remotion still src/remotion/index.tsx social-image public/assets/social.webp --image-format=webp",
    "og:post": "node --experimental-strip-types scripts/generate-post-og.ts",
    "og:all-posts": "node --experimental-strip-types scripts/generate-all-post-og.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@cloudflare/vite-plugin": "^1.22.1",
    "@fontsource-variable/montserrat": "^5.2.8",
    "@prose-ui/core": "^2.0.7",
    "@prose-ui/react": "^2.0.7",
    "@prose-ui/style": "^2.0.7",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-form-start": "^1.28.0",
    "@tanstack/react-router": "^1.150.0",
    "@tanstack/react-start": "^1.150.0",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "safe-mdx": "^1.3.9",
    "shadcn": "^3.7.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@content-collections/core": "^0.13.1",
    "@content-collections/vite": "^0.2.8",
    "@eslint/compat": "^2.0.1",
    "@eslint/js": "^9.39.2",
    "@remotion/cli": "4.0.414",
    "@remotion/tailwind-v4": "4.0.414",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/eslint-plugin-query": "^5.91.2",
    "@tanstack/eslint-plugin-router": "^1.141.0",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260129.1",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.2",
    "eslint-plugin-oxlint": "^1.39.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.2.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "oxlint": "^1.39.0",
    "oxlint-tsgolint": "^0.11.3",
    "remotion": "4.0.414",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.5",
    "wrangler": "^4.61.1",
    "zod": "^4.3.6"
  }
}
